import { activate, init, shutdown } from "../src/lib"

pipeline test_sourcehut_lifecycle_state_isolation(harness: Harness) {
  const state_key = "harn-sourcehut-connector.state"
  const foreign_key = "other-connector.state"
  shutdown(harness)
  harness.runtime.store_set(foreign_key, {active: true})
  const initialized = init(harness, {name: "sourcehut"})
  assert_eq(initialized.initialized, true, "initialization reports state")
  assert_eq(initialized.ctx.name, "sourcehut", "context stored")
  const first = activate(harness, [{id: "primary", path: "/hooks/sourcehut"}])
  assert_eq(first, {provider: "sourcehut", bindings: 1}, "response shape")
  assert_eq(harness.runtime.store_get(state_key).bindings.primary.binding_id, "primary")
  const before = harness.runtime.store_get(state_key)
  const duplicate = activate(
    harness,
    [{id: "one", path: "/hooks/shared"}, {id: "two", path: "/hooks/shared"}],
  )
  assert(is_err(duplicate), "duplicate path rejects")
  assert_eq(unwrap_err(duplicate).code, "activation")
  assert_eq(harness.runtime.store_get(state_key), before, "duplicate path cannot mutate state")
  assert_eq(shutdown(harness), {provider: "sourcehut", active: false}, "shutdown response shape")
  assert_eq(harness.runtime.store_get(state_key), nil, "own lifecycle state cleared")
  assert_eq(harness.runtime.store_get(foreign_key).active, true, "foreign state preserved")
  harness.runtime.store_delete(foreign_key)
}
